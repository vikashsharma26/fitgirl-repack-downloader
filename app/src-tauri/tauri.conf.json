{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FitDL",
  "version": "0.1.0",
  "identifier": "com.vikashsharma.fitdl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FitDL",
        "width": 1180,
        "height": 740,
        "minWidth": 820,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vikash Sharma",
    "shortDescription": "Fast, resumable downloader for FitGirl Repacks",
    "longDescription": "FitDL downloads FitGirl Repacks files from fuckingfast.co with multiple connections per file, automatic resume and a browser extension.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
